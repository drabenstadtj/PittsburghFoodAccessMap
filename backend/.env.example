# Copy this file to .env and fill in the values before deploying.
# The .env file is gitignored and should never be committed.

# Flask environment: "production" or "development"
FLASK_ENV=production

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# Comma-separated list of allowed origins (your domain, no trailing slash)
# Example: https://food-map.yourdomain.com
# For local dev: http://localhost:3000
CORS_ORIGINS=https://your-domain.com

# Optional: override the database path (defaults to SQLite at database/prod.db)
# DATABASE_URL=sqlite:////app/database/prod.db
